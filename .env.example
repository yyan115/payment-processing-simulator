# Copy to .env and fill in what you need. .env is ignored by Git. Never commit real credentials.

# --- Application ---------------------------------------------------------
# true: public-demo mode, with a private temporary workspace for each visitor.
DEMO_ENABLED=true
# true: a background worker resolves UNKNOWN payouts. The demo does this from the browser.
RECONCILIATION_ENABLED=false
# Network used when a request does not name one: simulated, mastercard or visa.
PAYMENTS_PROVIDER=simulated

# --- Mastercard Send sandbox (docs/mastercard.md) --------------------------
# MASTERCARD_ENABLED=true
# MASTERCARD_PARTNER_ID=
# MASTERCARD_CONSUMER_KEY=
# MASTERCARD_KEY_ALIAS=
# MASTERCARD_KEY_PASSWORD=
# The signing key: a base64 value (containers) or a file path (local runs).
# MASTERCARD_P12_BASE64=
# MASTERCARD_P12_PATH=
# MASTERCARD_SENDER_ACCOUNT_URI=
# MASTERCARD_RECIPIENT_ACCOUNT_URI=
# MASTERCARD_PAYMENT_TYPE=BDB
# MASTERCARD_FUNDING_SOURCE=DEBIT
# MASTERCARD_PAYMENT_ORIGINATION_COUNTRY=USA
# MASTERCARD_REQUEST_DETAILS_PATH=

# --- Visa Direct sandbox (docs/visa.md) ------------------------------------
# VISA_ENABLED=true
# VISA_USER_ID=
# VISA_PASSWORD=
# VISA_CERT_PEM_BASE64=
# VISA_KEY_PEM_BASE64=
# VISA_MLE_KEY_ID=
# VISA_MLE_SERVER_CERT_BASE64=
# VISA_MLE_PRIVATE_KEY_BASE64=

# --- Public demo limits ----------------------------------------------------
# New workspaces per minute from one address.
# DEMO_ADMISSIONS_PER_MINUTE=30
# Sandbox calls per workspace, per minute (all workspaces) and per day.
# DEMO_MASTERCARD_CALLS_PER_SESSION=10
# DEMO_MASTERCARD_CALLS_PER_MINUTE=12
# DEMO_MASTERCARD_CALLS_PER_DAY=100

# --- Bot check (optional, docs/deployment.md) ------------------------------
# TURNSTILE_REQUIRED=true
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# TURNSTILE_HOSTNAME=
