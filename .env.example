# Copy this file to .env and fill in the values you need.

# Public demo mode gives each visitor a private temporary workspace.
DEMO_ENABLED=true
# A background worker resolves UNKNOWN payments. The demo reconciles from the browser instead.
RECONCILIATION_ENABLED=false
# The payment network used when a request names none. Use simulated, mastercard or visa.
PAYMENTS_PROVIDER=simulated

# Mastercard Send sandbox. The values come from a Mastercard Developers project with Mastercard Send access.
# MASTERCARD_ENABLED=true
# MASTERCARD_PARTNER_ID=
# MASTERCARD_CONSUMER_KEY=
# MASTERCARD_KEY_ALIAS=
# MASTERCARD_KEY_PASSWORD=
# The signing key is a base64 value in containers and a file path for local runs.
# MASTERCARD_P12_BASE64=
# MASTERCARD_P12_PATH=
# MASTERCARD_SENDER_ACCOUNT_URI=
# MASTERCARD_RECIPIENT_ACCOUNT_URI=
# MASTERCARD_PAYMENT_TYPE=BDB
# MASTERCARD_FUNDING_SOURCE=DEBIT
# MASTERCARD_PAYMENT_ORIGINATION_COUNTRY=USA
# MASTERCARD_REQUEST_DETAILS_PATH=docs/examples/mastercard-sandbox-parties.json

# Visa Direct sandbox. The values come from a Visa Developer Platform project with the Visa Direct product.
# Encode each certificate and key file with base64 -w0.
# VISA_ENABLED=true
# VISA_USER_ID=
# VISA_PASSWORD=
# VISA_CERT_PEM_BASE64=
# VISA_KEY_PEM_BASE64=
# VISA_MLE_KEY_ID=
# VISA_MLE_SERVER_CERT_BASE64=
# VISA_MLE_PRIVATE_KEY_BASE64=

# Limits for the public demo. The defaults suit a single visitor.
# New workspaces per minute from one address.
# DEMO_ADMISSIONS_PER_MINUTE=30
# Sandbox calls per workspace, per minute across all workspaces, and per day.
# DEMO_MASTERCARD_CALLS_PER_SESSION=10
# DEMO_MASTERCARD_CALLS_PER_MINUTE=12
# DEMO_MASTERCARD_CALLS_PER_DAY=100

# Cloudflare Turnstile bot check for the sandbox networks.
# TURNSTILE_REQUIRED=true
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# TURNSTILE_HOSTNAME=
