# Default demo: both UI and API use the real Java/PostgreSQL engine.
DEMO_ENABLED=true
RECONCILIATION_ENABLED=false
PAYMENTS_PROVIDER=simulated

# Set MASTERCARD_ENABLED=true only after creating a Mastercard Developers
# project and downloading sandbox credentials. Never commit real credentials.
# MASTERCARD_ENABLED=true
# MASTERCARD_BASE_URL=https://sandbox.api.move.mastercard.com
# MASTERCARD_PARTNER_ID=
# MASTERCARD_CONSUMER_KEY=
# For Docker, supply the key as MASTERCARD_P12_BASE64 instead.
# MASTERCARD_P12_BASE64=
# MASTERCARD_P12_PATH=/absolute/path/to/your-sandbox-signing-key.p12
# MASTERCARD_KEY_ALIAS=keyalias
# MASTERCARD_KEY_PASSWORD=keystorepassword

# Use account URIs from your Mastercard sandbox configuration.
# Recipient account URI is required. The remaining transaction fields depend
# on the partner profile Mastercard configures during onboarding.
# MASTERCARD_RECIPIENT_ACCOUNT_URI=
# MASTERCARD_SENDER_ACCOUNT_URI=
# MASTERCARD_PAYMENT_TYPE=BDB
# MASTERCARD_FUNDING_SOURCE=
# MASTERCARD_PAYMENT_ORIGINATION_COUNTRY=
# MASTERCARD_TRANSACTION_TIME_ZONE=

# Optional JSON party details for a directly launched Java application.
# MASTERCARD_REQUEST_DETAILS_PATH=/absolute/path/to/request-details.json

# Optional Cloudflare Turnstile protection for public Mastercard use.
# Real widget keys are required before enabling this.
# TURNSTILE_REQUIRED=true
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# TURNSTILE_HOSTNAME=payment-processing-simulator.yyan115.blitz.cloud
DEMO_MASTERCARD_CALLS_PER_SESSION=10
