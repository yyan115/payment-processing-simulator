# Default local mode uses the deterministic simulator.
PAYMENTS_PROVIDER=simulated

# Set PAYMENTS_PROVIDER=mastercard only after creating a Mastercard Developers
# project and downloading sandbox credentials. Never commit real credentials.
# PAYMENTS_PROVIDER=mastercard
# MASTERCARD_BASE_URL=https://sandbox.api.mastercard.com
# MASTERCARD_PARTNER_ID=
# MASTERCARD_CONSUMER_KEY=
# MASTERCARD_P12_PATH=/absolute/path/to/your-sandbox-signing-key.p12
# MASTERCARD_KEY_ALIAS=keyalias
# MASTERCARD_KEY_PASSWORD=keystorepassword

# Public sandbox test values from Mastercard's reference application can be
# overridden if your Mastercard Developers project specifies different values.
# MASTERCARD_SENDER_ACCOUNT_URI=raw:12345678901234567890
# MASTERCARD_RECIPIENT_ACCOUNT_URI=pan:5013040000000018;exp=2077-05
